# Скопировать в .env и подставить свои значения.
# Файл .env в git не попадает (.gitignore).

# ID секретов Lockbox (не сами пароли/endpoint — payload только с правами IAM)
YDB_ENDPOINT_SECRET_ID=<lockbox-secret-id-ydb-endpoint>
YDB_DATABASE_SECRET_ID=<lockbox-secret-id-ydb-database>

# AI Studio / Responses
SEARCH_INDEX_ID=<vector-store-id>
AGENT_ID=<agent-id>
MCP_YDB_TICKETS_URL=<mcp-gateway-sse-url>

# Почта (только в .env / Lockbox у Cloud Functions, не в репозитории)
# IMAP_USER=
# IMAP_PASSWORD=
# SMTP_USER=
# SMTP_PASSWORD=
