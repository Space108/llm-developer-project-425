# Скопировать в .env и подставить свои значения.
# Файл .env в git не попадает (.gitignore).

# YDB (значения из Lockbox: ydb-endpoint, ydb-database)
YDB_ENDPOINT=<grpcs://ydb.serverless.yandexcloud.net:2135>
YDB_DATABASE=<ydb-database-path>

# AI Studio / Responses
YC_FOLDER_ID=<yc-folder-id>
SEARCH_INDEX_ID=<vector-store-id>
AGENT_ID=<agent-id>
MCP_YDB_TICKETS_URL=<mcp-gateway-sse-url>
YDB_TICKETS_FUNCTION_ID=<ydb-tickets-function-id>

# Почта (только в .env / Lockbox у Cloud Functions, не в репозитории)
IMAP_HOST=<imap-host>
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=<smtp-host>
SMTP_USER=
SMTP_PASSWORD=
